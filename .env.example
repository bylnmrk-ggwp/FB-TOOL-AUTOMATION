# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Storage (paths are resolved relative to the repository root)
# ---------------------------------------------------------------------------
DATABASE_FILE=./data/database/fb-automation.sqlite
PROFILE_DIR=./data/browser-profiles
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
IMPORT_DIR=./data/imports
LOG_DIR=./data/logs

# ---------------------------------------------------------------------------
# Automation
# ---------------------------------------------------------------------------
# Leave empty to use the Chromium bundled with Playwright.
BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=chromium
BROWSER_HEADLESS=false
GLOBAL_CONCURRENCY=2
DEFAULT_TIMEOUT_MS=30000
DEFAULT_MAX_RETRIES=2
STALE_JOB_TIMEOUT_MS=900000
PROFILE_LOCK_TTL_MS=300000

# ---------------------------------------------------------------------------
# Web (apps/web, read at build time by Vite)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Control panel
# ---------------------------------------------------------------------------
# The built web app (`pnpm build`). When this directory exists the API serves
# it at / on its own port, which is how the Windows service runs the whole
# system from one process. In development Vite serves the app instead.
WEB_DIST=./apps/web/dist

# ---------------------------------------------------------------------------
# Roster (Google Sheet)
# ---------------------------------------------------------------------------
# Service-account JSON key the sheet is shared with. Keep it out of git.
SHEETS_SERVICE_ACCOUNT=./.secrets/sheets-service-account.json
SHEETS_SHEET_ID=1oKKPnfTCn7LXqO9kboS3Jx2Aw8aWYeVh9PordjNxFeM
SHEETS_TAB=Sheet1
