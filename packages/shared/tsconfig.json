{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is included for the timer and crypto globals only: this package must
    // stay usable from both the browser and Node without Node-only typings.
    "lib": ["ES2023", "DOM"],
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"]
}
