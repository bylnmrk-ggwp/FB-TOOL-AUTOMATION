{
  "name": "fb-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @fb/web dev",
    "dev:server": "pnpm --filter @fb/server dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @fb/database db:generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:seed": "tsx scripts/seed.ts",
    "accounts:import": "tsx scripts/import-accounts.ts",
    "clean": "pnpm -r exec rimraf dist .turbo && rimraf node_modules/.cache"
  },
  "devDependencies": {
    "@fb/application": "workspace:*",
    "@fb/database": "workspace:*",
    "@fb/domain": "workspace:*",
    "@fb/queue": "workspace:*",
    "@fb/server": "workspace:*",
    "fastify": "^5.2.0",
    "@fb/shared": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@playwright/test": "^1.49.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
